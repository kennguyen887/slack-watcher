# ── Required ────────────────────────────────────────────────────────────────

# Slack user token (xoxp-...) with scopes: search:read, chat:write
# Recommended extra scopes: channels:history, groups:history, im:history, mpim:history
# (conversation context around mentions), files:read (read attached screenshots/logs),
# users:read (DM by @username via send.js)
SLACK_USER_TOKEN=xoxp-your-token-here

# ── Core behavior ───────────────────────────────────────────────────────────

# How often to poll Slack search for new mentions (seconds, min 30)
POLL_INTERVAL_SECONDS=45

# Root folder containing all your team's repos (defaults to ../../ relative to slack-watcher)
# REPOS_ROOT=/Users/you/dev/your-workspace

# Branch that workers base their work on and target with PRs (per repo convention)
BASE_BRANCH=main

# Override the Slack search query. Default: <@YOUR_USER_ID> (resolved automatically via auth.test).
# If raw-ID search returns nothing in your workspace, use your display name, e.g. "@Ken"
# SLACK_SEARCH_QUERY=

# Secondary search: messages containing PR links also trigger reviews (no mention needed).
# Set to your GitHub org URL prefix; leave empty to react to mentions only.
# PR_SEARCH_QUERY=github.com/your-org

# Optional path (relative to REPOS_ROOT) holding per-repo context docs named <repo>.md,
# used to teach the classifier what each repo does. Falls back to each repo's CLAUDE.md/README.md.
# DOCS_CONTEXT_DIR=docs/context

# ── Claude workers ──────────────────────────────────────────────────────────

# Path to the claude CLI binary (default: "claude" from PATH)
# CLAUDE_BIN=claude

# Model used for cheap mention classification
CLASSIFIER_MODEL=haiku

# Model for code-fix and question workers. Pinned explicitly so the daemon never
# inherits a drifting CLI default you may not have access to. Use a CLI alias
# (haiku/sonnet/opus) or a full model id. Must be a model your account can use.
WORKER_MODEL=sonnet

# Model for PR code review — defaults to the most capable model since review
# quality matters most. Override if you don't have opus access.
REVIEW_MODEL=opus

# Extra args passed to code/review workers.
# Default skips permission prompts so workers can edit/commit/push unattended — see README for the risk.
# WORKER_CLAUDE_ARGS=--dangerously-skip-permissions

# Cancel window before a worker starts: the watcher DMs you "Starting in N min",
# waits, and aborts if you reply "stop" (or "cancel/skip") in your self-DM.
# Guards against you and the bot doing the same task twice. 0 = start immediately.
WORKER_GRACE_MINUTES=3

# Kill the code worker / PR review worker / answer drafter after this many minutes
WORKER_TIMEOUT_MINUTES=45
REVIEW_TIMEOUT_MINUTES=30
ANSWER_TIMEOUT_MINUTES=10

# How far around a mention (seconds, each direction) to pull channel messages as
# conversation context. 0 disables. Threads always pull the whole thread.
CONTEXT_WINDOW_SECONDS=900

# ── CloudWatch error → auto-fix source ───────────────────────────────────────
# Consumes the JSONL event log the infrascope alerter writes (its CWALERT_EVENT_LOG).
# For each new severity:error signature it opens a fix PR and DMs you the URL.
# The worker self-filters: non-code errors (integration/config/transient) get a
# "not auto-fixable" DM instead of a bogus PR.

# 1 = enable the source. Off by default.
CWALERT_ENABLED=0
# Path to the shared event log — MUST match infrascope's CWALERT_EVENT_LOG.
# Default: <slack-watcher>/events/cwalert.jsonl
# CWALERT_EVENT_LOG=/home/you/development/slack-watcher/events/cwalert.jsonl
# PR base branch for auto-fixes (falls back to BASE_BRANCH, then "main"). Never use master/main for release work.
CWALERT_BASE_BRANCH=rc
# 1 = open the PR as a draft; 0 = ready for review (default).
CWALERT_DRAFT=0
# Don't re-attempt the same error signature within this many hours.
CWALERT_COOLDOWN_HOURS=12
# Max distinct error signatures to auto-fix per poll (storm guard). Extras are noted, not fixed.
CWALERT_MAX_PER_POLL=2
# Optional JSON map of alerter service name → repo folder under REPOS_ROOT.
# Default derives the folder from the service name (strips a trailing " (...)" suffix).
# CWALERT_SERVICE_REPOS={"legacy-api":"legacy-api","listings-api":"listings-api"}

# ── Misc ────────────────────────────────────────────────────────────────────

# 1 = detect + classify mentions but do not run workers or post to Slack
DRY_RUN=0
