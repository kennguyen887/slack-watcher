<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.slack-watcher</string>
    <!-- One poll per interval via cron-run.sh (which carries the overlap guard),
         NOT a KeepAlive daemon: each run loads the latest code, so a `git pull`
         deploys itself on the next tick with no restart. MUST run as a gui/<uid>
         LaunchAgent (not crontab): the `claude` CLI reads its OAuth token from the
         login Keychain, which only the GUI session can unlock — a crontab entry
         authenticates as "OAuth session expired". -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__WATCHER_DIR__/cron-run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__WATCHER_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>StandardOutPath</key>
    <string>__WATCHER_DIR__/logs/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>__WATCHER_DIR__/logs/watcher.err.log</string>
</dict>
</plist>
