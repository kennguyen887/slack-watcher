<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.slack-watcher-daily</string>
    <!-- Every 5 min; src/daily-report.js is a no-op outside Mon–Fri / its window and until
         today's random post time. A gui LaunchAgent for the same Keychain reason as the watcher. -->
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__WATCHER_DIR__/src/daily-report.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__WATCHER_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__WATCHER_DIR__/logs/daily-report.log</string>
    <key>StandardErrorPath</key>
    <string>__WATCHER_DIR__/logs/daily-report.err.log</string>
</dict>
</plist>
